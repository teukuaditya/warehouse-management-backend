// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  userId        Int            @id @default(autoincrement())
  username      String         @unique
  email         String         @unique
  password      String
  role          String         @default("WH_OPERATOR")
  status        String         @default("FREE")
  createdAt     DateTime       @default(now())
  spk           SPK[]
  notifications Notification[]
}

model Material {
  materialId   Int      @id @default(autoincrement())
  name         String   @unique
  descriptions String?
  quantity     Int
  status       String   @default("UNAVAILABLE")
  createdAt    DateTime @default(now())
  spk          SPK[]
}

model SPK {
  spkId             Int       @id @default(autoincrement())
  userId            Int
  materialId        Int
  quantityOrder     Int
  tanggal_pengajuan DateTime  @default(now())
  penerima          String
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [userId])
  material Material @relation(fields: [materialId], references: [materialId])
}

model Notification {
  notifId   Int      @id @default(autoincrement())
  userId    Int
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])
}